#!/bin/zsh

set -u

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

check_status=0

run_check() {
  local label=$1
  shift

  if "$@"; then
    printf '  [OK]   %s\n' "$label"
  else
    printf '  [FAIL] %s\n' "$label" >&2
    check_status=1
  fi
}

check_final_newlines() {
  local file last_byte
  local newline_status=0

  while IFS= read -r -d $'\0' file; do
    [[ -f "$file" && -s "$file" ]] || continue
    LC_ALL=C grep -Iq . "./$file" || continue

    last_byte=$(tail -c 1 "./$file" | od -An -t x1 | tr -d '[:space:]')
    if [[ "$last_byte" != "0a" ]]; then
      printf 'Missing final newline: %s\n' "$file" >&2
      newline_status=1
    fi
  done < <(git ls-files -z --cached --others --exclude-standard)

  return "$newline_status"
}

check_repository_whitespace() {
  local file output
  local whitespace_status=0

  while IFS= read -r -d $'\0' file; do
    [[ -f "$file" && -s "$file" ]] || continue
    LC_ALL=C grep -Iq . "./$file" || continue

    output=$(git --no-pager diff --no-index --check /dev/null "./$file" 2>&1)
    if [[ -n "$output" ]]; then
      printf '%s\n' "$output" >&2
      whitespace_status=1
    fi
  done < <(git ls-files -z --cached --others --exclude-standard)

  return "$whitespace_status"
}

check_sensitive_filenames() {
  local file filename
  local filename_status=0

  while IFS= read -r -d $'\0' file; do
    filename=${file:t}
    [[ "$filename" == '.env.example' ]] && continue

    case $filename in
      .env|.env.*|auth.json|credentials.json|*.key|*.pem|*.p12|*.pfx|\
        id_dsa|id_ecdsa|id_ecdsa_sk|id_ed25519|id_ed25519_sk|id_rsa)
        printf 'Sensitive filename tracked: %s\n' "$file" >&2
        filename_status=1
        ;;
    esac
  done < <(git ls-files -z --cached)

  return "$filename_status"
}

check_gitleaks() {
  local mode=$1 output
  shift

  if ! output=$(gitleaks "$mode" --no-banner --no-color --redact \
    --verbose "$@" 2>&1); then
    printf '%s\n' "$output" >&2
    return 1
  fi
}

check_zsh_syntax() {
  local file

  for file in \
    .zprofile \
    .zshrc \
    script/check \
    script/doctor \
    script/lib/links.zsh \
    script/setup \
    script/test-setup; do
    zsh -n "$file" || return 1
  done
}

check_shell_environment() {
  local output

  if ! output=$(ZDOTDIR="$repo_root" zsh -lc '
    [[ "$EDITOR" == "mate -w" ]] || {
      print -u2 "Expected EDITOR to be mate -w"
      exit 1
    }

    [[ "$VISUAL" == "$EDITOR" ]] || {
      print -u2 "Expected VISUAL to match EDITOR"
      exit 1
    }

    profile_path_size=${#path}
    path+=("${path[1]}")
    (( ${#path} == profile_path_size )) || {
      print -u2 "Expected PATH entries to remain unique"
      exit 1
    }
  ' 2>&1); then
    printf '%s\n' "$output" >&2
    return 1
  fi
}

check_herdr_config() {
  local output

  if ! output=$(HERDR_CONFIG_PATH="$repo_root/.config/herdr/config.toml" \
    herdr config check 2>&1); then
    printf '%s\n' "$output" >&2
    return 1
  fi
}

check_moshi_config() {
  local output

  if ! output=$(XDG_CONFIG_HOME="$repo_root/.config" moshi-hook set 2>&1); then
    printf '%s\n' "$output" >&2
    return 1
  fi
}

check_textmate_property_lists() {
  local file output
  local plist_status=0

  for file in \
    .config/textmate/Dotfiles.tmbundle/info.plist \
    .config/textmate/Dotfiles.tmbundle/Themes/Dracula.tmTheme; do
    if ! output=$(plutil -lint "$file" 2>&1); then
      printf '%s\n' "$output" >&2
      plist_status=1
    fi
  done

  return "$plist_status"
}

printf 'Checking dotfiles...\n'

run_check 'Repository whitespace' check_repository_whitespace
run_check 'Staged whitespace' git --no-pager diff --cached --check
run_check 'Sensitive filenames' check_sensitive_filenames
run_check 'Working tree secrets' check_gitleaks dir
run_check 'Staged secrets' check_gitleaks git --pre-commit --staged
run_check 'Git history secrets' check_gitleaks git
run_check 'Zsh syntax' check_zsh_syntax
run_check 'Setup fixtures' script/test-setup
run_check 'Shell environment' check_shell_environment
run_check 'Herdr config' check_herdr_config
run_check 'Moshi config' check_moshi_config
run_check 'TextMate property lists' check_textmate_property_lists
run_check 'Final newlines' check_final_newlines
run_check 'macOS Icon ignore pattern' git check-ignore -q -- $'Icon\r'
run_check 'macOS HFS ignore pattern' git check-ignore -q -- \
  $'.HFS+ Private Directory Data\r'

if (( check_status != 0 )); then
  printf '\nDotfiles checks failed.\n' >&2
  exit "$check_status"
fi

printf '\nAll dotfiles checks passed.\n'
